# Use this as a separate TLS virtual host, e.g. ws.example.org.
# Replace the certificate paths with the certificates managed by your host.
server {
    listen 443 ssl;
    http2 on;
    server_name ws.example.org;

    ssl_certificate     /etc/letsencrypt/live/ws.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ws.example.org/privkey.pem;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Scheme $scheme;
        proxy_set_header SERVER_PORT $server_port;
        proxy_set_header REMOTE_ADDR $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass http://127.0.0.1:8080;
    }
}
