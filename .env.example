APP_NAME="Personnel Information System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Reverb credentials: generate unique production values; never commit real secrets.
REVERB_APP_ID=pis-local
REVERB_APP_KEY=replace-with-a-random-key
REVERB_APP_SECRET=replace-with-a-long-random-secret
# Reverb listener. Keep this private behind a TLS reverse proxy in production.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Backend broadcast target and browser WebSocket endpoint (same in local dev).
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_CLIENT_HOST=127.0.0.1
REVERB_CLIENT_PORT=8080
REVERB_CLIENT_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_CLIENT_HOST}"
VITE_REVERB_PORT="${REVERB_CLIENT_PORT}"
VITE_REVERB_SCHEME="${REVERB_CLIENT_SCHEME}"
LOG_CHANNEL=stack
BROADCAST_CONNECTION=reverb
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=personnel_information_system
DB_USERNAME=pis_app
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS="people@example.org"
MAIL_FROM_NAME="${APP_NAME}"
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
SUPERADMIN_EMAIL=superadmin@personnel.local
SUPERADMIN_PASSWORD=ChangeThisSuperAdmin!2026
ADMIN_EMAIL=admin@personnel.local
ADMIN_PASSWORD=ChangeThisAdmin!2026

# In production set APP_DEBUG=false and SESSION_SECURE_COOKIE=true behind HTTPS.
